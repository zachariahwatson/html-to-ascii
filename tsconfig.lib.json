{
	"extends": "./tsconfig.app.json",
	"compilerOptions": {
		"noEmit": false,
		"allowImportingTsExtensions": false,
		"moduleResolution": "node",
		"outDir": "dist",
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": false
	},
	"include": [
		"lib",
		"lib/contexts",
		"lib/hooks",
		"lib/providers",
		"lib/types",
		"lib/utils",
		"lib/components",
		"lib/index.ts"
	]
}
